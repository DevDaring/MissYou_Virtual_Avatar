# ---- Provider keys (.env) — names only, never commit values ----
# AWS_* / GCP_* / GOOGLE_CLOUD_* / GOOGLE_APPLICATION_CREDENTIALS are IGNORED by policy (never used).
LINKAPI_BASE_URL=            # OpenAI-compatible relay base URL (default https://api.linkapi.org/v1)
LINKAPI_API_KEY=             # or LINKAPI_AzureOpenAI_KEY — primary LLM when reachable
LINKAPI_Gemini_Cheap_KEY=    # optional LinkAPI Gemini key
LINKAPI_CHAT_MODEL=          # default gpt-4o-mini
OPENAI_API_KEY=              # or Open_AI_2009_Key — LLM, moderation, transcription, TTS fallback
OPENAI_CHAT_MODEL=           # default gpt-4.1-mini
ANTHROPIC_API_KEY=           # or Calude_2009_API_Key — LLM fallback
OPENROUTER_API_KEY_1=        # LLM fallback
DEEPSEEK_API_KEY_1=          # LLM fallback
GEMINI_API_KEY_1=            # Gemini via AI Studio (optional; not GCP billing). _2.._4 also read
XAI_API_KEY=                 # or Grok_API_KEY — scene stills + idle loops (+ TTS fallback)
XAI_IMAGE_MODEL=             # default grok-imagine-image-2.0
XAI_VIDEO_MODEL=             # default grok-imagine-video-1.5-lite
SARVAM_API_KEY=              # or SARVAM_2009_API_KEY / SARVAM_88_API_KEY / SARVAM_PHD_API_KEY — STT, TTS, Bengali cloning
SARVAM_STT_MODEL=            # default saaras:v4
SARVAM_TTS_MODEL=            # default bulbul:v3
FISH_AUDIO_API_KEY=          # optional (not integrated yet)
FAL_KEY=                     # optional: lip-sync / talking head (integration point providers/lipsync.py)
ELEVENLABS_API_KEY=          # optional
DEEPGRAM_API_KEY=            # optional
RAZORPAY_KEY_ID=             # payments (interface stubbed until set)
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=              # email OTP / receipts; without it mail goes to the admin outbox
SENTRY_DSN=                  # optional error tracking
VOICE_ENGINE_URL=            # default http://127.0.0.1:17493 (internal only)
VOICE_ENGINE_ENABLED=        # default true

# ---- App settings (missyou.env) ----
MISSYOU_ENV=                 # development | production
MISSYOU_PUBLIC_URL=          # https://missyou.koushikdeb.com
MISSYOU_DATABASE_URL=        # postgresql+asyncpg://missyou:PASSWORD@127.0.0.1:5432/missyou
MISSYOU_TEST_DATABASE_URL=   # separate DB for tests
MISSYOU_REDIS_URL=           # redis://127.0.0.1:6379/7
MISSYOU_JWT_SECRET=          # long random string
MISSYOU_URL_SECRET=          # signs expiring media URLs
MISSYOU_MEDIA_KEY=           # 32-byte urlsafe base64 AES key for media at rest — BACK IT UP
MISSYOU_STORAGE_DIR=         # default <root>/storage
MISSYOU_SECURE_COOKIES=      # true behind HTTPS
MISSYOU_CAP_GLOBAL_DAILY_USD=     # budget caps (0 = no cap)
MISSYOU_CAP_GLOBAL_MONTHLY_USD=
MISSYOU_CAP_PROVIDER_DAILY_USD=
MISSYOU_CAP_USER_DAILY_USD=
MISSYOU_INR_PER_USD=         # default 88
MISSYOU_ADMIN_EMAIL=         # budget-cap notices
MISSYOU_FREE_TRIAL_CREDITS=  # default 200
MISSYOU_DAILY_MINUTES=       # default 30 (users can lower)
MISSYOU_CALL_SOFT_LIMIT_MIN= # default 15
MISSYOU_CALL_ADMIN_MAX_MIN=  # default 30
MISSYOU_IDENTITY_THRESHOLD=  # ArcFace similarity for generated stills, default 0.32
MISSYOU_MINOR_AGE_THRESHOLD= # refuse when median estimated age below this, default 16
MISSYOU_DEMO_USERNAME=       # jury account (default from User=)
MISSYOU_DEMO_PASSWORD=       # (default from Password=)
MISSYOU_DEMO_ADMIN_2FA_WAIVED= # default true (jury only)
MISSYOU_GPU_WORKER_SECRET=   # set when a remote GPU worker is attached

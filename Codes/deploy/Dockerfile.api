FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg g++ curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app/backend
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ /app/backend/
COPY config/ /app/config/
COPY prompts/ /app/prompts/
COPY docs/ /app/docs/
ENV MISSYOU_ROOT=/app PYTHONPATH=/app/backend
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8170 --workers 2 --proxy-headers"]
